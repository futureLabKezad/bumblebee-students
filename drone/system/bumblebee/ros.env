# ROS 2 network scope of this drone, read by the Bumblebee services (systemd
# drop-ins ros-env.conf) and by login shells (/etc/profile.d/bumblebee-ros.sh).
#
# LOCALHOST (default): the drone's ROS nodes only talk to nodes on this drone.
#   Several drones on one Wi-Fi then never see each other's topics or services
#   -- with a shared network an "arm" call meant for one drone can reach
#   another. The GCS apps are not affected: they use rosbridge (port 9090),
#   the camera stream (8080) and the HTTP APIs, not DDS.
#
# rviz2/rqt from a laptop on the same Wi-Fi: set SUBNET and a ROS_DOMAIN_ID
# that no other drone on that Wi-Fi uses (1-101), reboot the drone, and on the
# laptop run: export ROS_DOMAIN_ID=<the same number>
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
#ROS_DOMAIN_ID=0
