<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_flow_cam640'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>model://x500_flow</uri>
    </include>
    <link name="cam640_link">
      <pose relative_to="base_link">0.05 0 -0.06 0 1.5707 0</pose>
      <inertial>
        <mass>0.010</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="cam640" type="camera">
        <camera>
          <horizontal_fov>1.8</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.05</near><far>100</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>@CAM_RATE@</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="cam640_joint" type="fixed">
      <parent>base_link</parent>
      <child>cam640_link</child>
    </joint>
  </model>
</sdf>
