<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bumblebee (Future Lab school quad X) for PX4 v1.16.1 SITL + Gazebo Harmonic.
  GENERATED by tools/make_model.py (batteries=glb2, rotor diagonal 0.63 m, rotor inertia physical). Do not edit by hand:
  change the generator and re-run it.  Every number and its source: ../../README.md.
  Frame: base_link FLU (+X nose, +Y left, +Z up), origin = centre of the motor axes on the motor plane.
  The landed model has its feet at z = -0.217, so spawn / include it at z >= 0.22.
-->
<sdf version="1.9" xmlns:gz="http://gazebosim.org/schema">
