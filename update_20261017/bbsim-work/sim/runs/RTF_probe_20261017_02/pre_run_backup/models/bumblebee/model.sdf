    <!-- Optical flow: same sensors as PX4 model://optical_flow (used by x500_flow), inlined so the
         model is self-contained and the flow board mass is not counted twice.  PX4's
         OpticalFlowSystem looks up the sibling sensor named flow_camera in the same link.
         Position = EKF2_OF_POS (PARAMS) in FLU, no yaw (SENS_FLOW_ROT=0). -->
    <link name="flow_link">
      <pose relative_to="base_link">0.072 0.028 -0.034 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <sensor name="flow_camera" type="camera">
        <pose>0 0 0 0 1.5708 0</pose>
        <camera>
          <horizontal_fov>0.733038</horizontal_fov>
          <image>
            <width>100</width>
            <height>100</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>30</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
      </sensor>
      <sensor name="optical_flow" type="custom" gz:type="optical_flow">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="flow_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_link</child>
    </joint>

    <!-- Rangefinder (real: DroneCAN, UAVCAN_SUB_RNG=1). Link/sensor pose nesting copied from PX4
         x500_flow / x500_lidar_down: the link pitch +90 deg points the ray down, the sensor roll 180 deg
         is what GZBridge tests (scan world_pose ~ (0,1,0,0)) to tag it ROTATION_DOWNWARD_FACING.
         Position = EKF2_RNG_POS (PARAMS) in FLU; limits = UAVCAN_RNG_MIN/MAX (PARAMS). -->
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0.072 0.028 -0.034 0 1.5708 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 3.14159 0 0</pose>
        <update_rate>50</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>30</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <!-- ESTIMATED 1 cm (GZBridge reports variance 0; EKF2 uses EKF2_RNG_NOISE) -->
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>

    <!-- Downward main camera (REPO): 640x480 @ 30 Hz, pinhole with the real calibrated K
         (main_camera_640x480.yaml). The real lens is equidistant fisheye; ogre2 cannot render that, so
         this image has the GEOMETRY of aruco_detect's rectified frame (new_K = K) but far better quality
         (no 5-row camera_fix decimation, no fisheye resampling, no noise/blur): optimistic for ArUco.
         Quick mode: bridge Gazebo's own camera_info (plumb_bob, D = 0), NOT the real yaml.
         Strict mode: re-distort with the real K/D in a sim node and run the real camera_fix (README).
         Pose = static TF base_link -> main_camera_optical from bumblebee.launch.py
         (optical axis down, image top = nose, image right = starboard). -->
    <link name="main_camera_link">
      <pose relative_to="base_link">0.05 0 -0.07 0 1.5708 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <sensor name="main_camera" type="camera">
        <camera>
          <!-- total horizontal FOV of K: atan(cx/fx) + atan((W-cx)/fx) -->
          <horizontal_fov>1.80146</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
          <lens>
            <type>gnomonical</type>
            <intrinsics>
              <fx>251.9855</fx>
              <fy>314.813592</fy>
              <cx>352.087633</cx>
              <cy>306.346947</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <optical_frame_id>main_camera_optical</optical_frame_id>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="main_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>main_camera_link</child>
    </joint>

    <!-- Motors: T-Motor MN4006 KV380 + MF1503 15x5.4, 6S, 24 V basis (motor_params.json).
         Numbering/spin = PX4 quad X: 0 FR ccw, 1 RL ccw, 2 FL cw, 3 RR cw. PX4 sends rad/s on
         /<model>/command/motor_speed (SIM_GZ_EC_MIN + (MAX - MIN) * x, see the airframe). -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.03</timeConstantUp>
      <timeConstantDown>0.045</timeConstantDown>
      <maxRotVelocity>636</maxRotVelocity>
      <motorConstant>5.411e-05</motorConstant>
      <momentConstant>0.0187</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0.000205</rotorDragCoefficient>
      <rollingMomentCoefficient>3.5e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.03</timeConstantUp>
      <timeConstantDown>0.045</timeConstantDown>
      <maxRotVelocity>636</maxRotVelocity>
      <motorConstant>5.411e-05</motorConstant>
      <momentConstant>0.0187</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>0.000205</rotorDragCoefficient>
      <rollingMomentCoefficient>3.5e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.03</timeConstantUp>
      <timeConstantDown>0.045</timeConstantDown>
      <maxRotVelocity>636</maxRotVelocity>
      <motorConstant>5.411e-05</motorConstant>
      <momentConstant>0.0187</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>0.000205</rotorDragCoefficient>
      <rollingMomentCoefficient>3.5e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.03</timeConstantUp>
      <timeConstantDown>0.045</timeConstantDown>
      <maxRotVelocity>636</maxRotVelocity>
      <motorConstant>5.411e-05</motorConstant>
      <momentConstant>0.0187</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>0.000205</rotorDragCoefficient>
      <rollingMomentCoefficient>3.5e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
