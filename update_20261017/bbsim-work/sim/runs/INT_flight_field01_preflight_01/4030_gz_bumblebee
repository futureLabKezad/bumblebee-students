#!/bin/sh
#
# @name Gazebo Bumblebee
#
# @type Quadrotor
#
# Future Lab Bumblebee school quad X (4.274 kg, MN4006 KV380 + MF1503 15", 6S) for PX4 v1.16.1
# SITL + Gazebo Harmonic, model "bumblebee". GENERATED by bumblebee_model/tools/make_model.py.
# Sources of every value: bumblebee_model/README.md.  Standalone (does not source 4001_gz_x500,
# so no x500 values leak in).  Only geometry, ESC mapping, hover thrust, "no GPS", the real
# drone's EKF2 aiding set-up and the real drone's controller tuning are here; the rest of the real
# parameter file is NOT applied.
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=bumblebee}

param set-default SIM_GZ_EN 1

# --- Geometry (FRD). 0.63 m motor diagonal (USER) -> 0.2227 m; KM sign = spin (+ = CCW), |KM| = real
# CA_ROTORn_KM. The real file has PX/PY 0.25; for a symmetric X the allocation is normalised, so
# only the ratios and signs matter and both behave the same.
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.2227
param set-default CA_ROTOR0_PY 0.2227
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX -0.2227
param set-default CA_ROTOR1_PY -0.2227
param set-default CA_ROTOR1_KM 0.05

param set-default CA_ROTOR2_PX 0.2227
param set-default CA_ROTOR2_PY -0.2227
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.2227
param set-default CA_ROTOR3_PY 0.2227
param set-default CA_ROTOR3_KM -0.05

# --- Simulated ESCs: motor speed command [rad/s] = MIN + (MAX - MIN) * x (motor research, affine
# fit of the MF1503 speed curve at 24 V over 50-100 % throttle; the model clamps at maxRotVelocity 636)
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 153
param set-default SIM_GZ_EC_MIN2 153
param set-default SIM_GZ_EC_MIN3 153
param set-default SIM_GZ_EC_MIN4 153

param set-default SIM_GZ_EC_MAX1 650
param set-default SIM_GZ_EC_MAX2 650
param set-default SIM_GZ_EC_MAX3 650
param set-default SIM_GZ_EC_MAX4 650

# --- Thrust: the model hovers at ~0.58 of the command range (motor research, 24 V). MPC_THR_HOVER is
# the REAL drone's 0.5 on purpose: every real flight starts from it and the hover thrust estimator
# (MPC_USE_HTE 1, default) must converge to ~0.58; starting the sim at 0.58 would hide that.
# Check: listener hover_thrust_estimate -> ~0.58 in a steady hover.
param set-default THR_MDL_FAC 0
param set-default MPC_THR_HOVER 0.5

# --- No GPS (real: SYS_HAS_GPS 0, EKF2_GPS_CTRL 0; same switches as 4021_gz_x500_flow)
param set-default SYS_HAS_GPS 0
param set-default SIM_GPS_USED 0
param set-default EKF2_GPS_CTRL 0

# --- EKF2 aiding exactly as the real px4_v0_0_2.params: external vision (ArUco/VPE over MAVROS)
# + optical flow + rangefinder + baro, no magnetometer fusion, vision as height reference.
param set-default EKF2_EV_CTRL 15
param set-default EKF2_EV_DELAY 30
param set-default EKF2_EV_NOISE_MD 0
param set-default EKF2_EVP_NOISE 0.15
param set-default EKF2_HGT_REF 3
param set-default EKF2_BARO_CTRL 1
param set-default EKF2_OF_CTRL 1
param set-default EKF2_RNG_CTRL 1
param set-default EKF2_RNG_A_HMAX 5
param set-default EKF2_MIN_RNG 0.01
param set-default EKF2_RNG_QLTY_T 0.2
param set-default EKF2_MAG_TYPE 5

# Sensor lever arms (FRD, relative to the CoG = PX4 body origin): the REAL drone's values, kept as they
# are. The SDF puts the simulated H-Flow where the GLB2 has it (see model.sdf), so a wrong value here
# shows up in the sim the same way it would on the real drone.
param set-default EKF2_IMU_POS_X -0.05
param set-default EKF2_IMU_POS_Y 0
param set-default EKF2_IMU_POS_Z 0
param set-default EKF2_OF_POS_X 0.1
