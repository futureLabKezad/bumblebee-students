# Pinned versions for the simulator trial (POSIX sh syntax; sourced by the
# scripts in this folder and by .github/workflows/sim-trial.yml).
# Every value here is checked at build or run time; bump them on purpose only.

# PX4 SITL: exactly the firmware on the drones (FMU-v6C reports git 94cb2012).
# The tag object is GPG-signed by PX4; v1.16.1 dereferences to this commit.
PX4_REPO=https://github.com/PX4/PX4-Autopilot.git
PX4_TAG=v1.16.1
PX4_COMMIT=94cb2012792b2ae89f0b147cfee53ee31ae550be
# Gazebo models/worlds/server.config: gitlink of Tools/simulation/gz at that tag.
PX4_GZ_MODELS_COMMIT=e05f4312d3f28aa621157610584a4870406cb6d3

# PX4 v1.16.1 builds its optical-flow simulation library from PX4-OpticalFlow
# at "GIT_TAG master" (not pinned upstream; master moved on 2026-09-21).
# We pin the commit that was master when v1.16.1 was tagged (2026-01-21).
PX4_OPTICALFLOW_REPO=https://github.com/PX4/PX4-OpticalFlow.git
PX4_OPTICALFLOW_COMMIT=5d60b9eca7c069868526421e6a126daa8080fd41

# Gazebo Harmonic apt repository (exact package versions: apt-gz-harmonic.txt).
OSRF_APT_URL=https://packages.osrfoundation.org/gazebo/ubuntu-stable
OSRF_KEY_URL=https://packages.osrfoundation.org/gazebo.gpg
OSRF_KEY_SHA256=15d0300460e0c9c0efb21fa9770c0bf228988a07d71c4fac985c2161954a25a4
# Key fingerprint (for humans; the sha256 above is what is enforced):
# D2486D2DD83DB69272AFE98867170598AF249743 "OSRF Repository <osrfbuild@osrfoundation.org>"
GZ_SIM_VERSION=8.15.0

# Stock PX4 airframes used by the trial (PX4 v1.16.1 ROMFS/.../airframes).
#   x500_flow          4021: no GPS, optical flow camera 100x100@50Hz + 1-ray lidar@50Hz
#   x500_mono_cam_down 4014: GPS, downward camera 1280x960@30Hz
AIRFRAME_x500_flow=4021
AIRFRAME_x500_mono_cam_down=4014
